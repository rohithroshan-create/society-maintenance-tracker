# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (SQLite by default, zero config) ---
# For Postgres, use: postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Anyone registering with this code becomes an admin instead of a resident.
# Keep it secret; share it only with society office staff.
ADMIN_SIGNUP_CODE=letmein-admin

# --- Overdue detection default (can also be changed via /api/config) ---
OVERDUE_THRESHOLD_DAYS=5

# --- Email (any SMTP provider free tier works, e.g. Gmail App Password,
# Brevo, Mailtrap). If left blank, emails are logged to the console
# instead of sent, so the app still runs fully without email setup. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Society Maintenance <no-reply@society.local>"
